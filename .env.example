# Public site URL used for canonical links and sitemap
PUBLIC_SITE_URL=https://example.com

# Add these to use real recipes from Sanity. Without a project ID, the site shows labeled sample content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# The same project for the Sanity-hosted Studio.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Optional hostname prefix for sanity deploy, for example tamar-recipes.
SANITY_STUDIO_HOSTNAME=

# Mux is configured through sanity-plugin-mux-input in Sanity Studio.
