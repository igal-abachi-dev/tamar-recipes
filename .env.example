# Public site URL used for canonical links and sitemap
PUBLIC_SITE_URL=https://example.com

# Keep the site noindexed until reviewed content is ready. Set to true only at launch.
PUBLIC_SITE_INDEXING_ENABLED=false

# Add these to use real recipes from Sanity. Without a project ID, the site shows labeled sample content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# The same project for the Sanity-hosted Studio.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Optional hostname prefix for sanity deploy, for example tamar-recipes.
SANITY_STUDIO_HOSTNAME=
# Full site origin loaded inside Sanity's Presentation tool.
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321

# Server-only secrets for the on-demand draft recipe route. Use a Sanity viewer token
# and a long random value for PREVIEW_SECRET. Never prefix these with PUBLIC_.
SANITY_READ_TOKEN=
PREVIEW_SECRET=

# Mux is configured through sanity-plugin-mux-input in Sanity Studio.
