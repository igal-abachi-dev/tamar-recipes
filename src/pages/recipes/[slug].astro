---
import RecipePage from '../../components/pages/RecipePage.astro';
import { getSiteContent } from '../../lib/content';
import type { Recipe } from '../../types/content';
export async function getStaticPaths() {
  const { recipes, isDemo } = await getSiteContent();
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: {
      recipe,
      isDemo,
      linkedVersions: recipes.filter(
        (other) =>
          other.slug !== recipe.slug &&
          other.variations?.some((variation) => variation.linkedRecipe?.slug === recipe.slug),
      ),
      related: recipes
        .filter((other) => other.slug !== recipe.slug)
        .map((other) => ({
          recipe: other,
          score:
            (other.category?.slug === recipe.category?.slug ? 10 : 0) +
            (other.tags || []).filter((tag) => recipe.tags?.includes(tag)).length,
        }))
        .sort((a, b) => b.score - a.score)
        .slice(0, 3)
        .map((item) => item.recipe),
    },
  }));
}
interface Props {
  recipe: Recipe;
  isDemo: boolean;
  related: Recipe[];
  linkedVersions: Recipe[];
}
const { recipe, isDemo, related, linkedVersions } = Astro.props;
---

<RecipePage {recipe} {isDemo} {related} {linkedVersions} />
