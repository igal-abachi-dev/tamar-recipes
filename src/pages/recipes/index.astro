---
import Layout from '../../layouts/Layout.astro';
import RecipesPage from '../../components/pages/RecipesPage.svelte';
import RecipeSearch from '../../components/islands/RecipeSearch.svelte';
import { getSiteContent, imageSrc } from '../../lib/content';
import type { RecipeSearchItem } from '../../types/content';
import { allIngredientGroups, passoverStatus } from '../../lib/recipe-helpers';
const { recipes, categories, isDemo } = await getSiteContent();
const index: RecipeSearchItem[] = recipes.map((recipe) => ({
  title: recipe.title,
  slug: recipe.slug,
  description: recipe.description,
  imageUrl: imageSrc(recipe.image, 360, 270),
  categoryTitle: recipe.category?.title,
  tags: recipe.tags || [],
  ingredients: allIngredientGroups(recipe).flatMap((group) => group.items.map((item) => item.name)),
  dietaryLabels: recipe.dietaryLabels || [],
  passoverStatus: passoverStatus(recipe),
}));
---

<Layout
  title="כל המתכונים | אתר המתכונים של תמר"
  description="כל המתכונים של תמר, מסודרים לפי ארוחות עיקריות, אפייה, סלטים וקינוחים."
  noindex={isDemo}
>
  <RecipesPage
    {recipes}
    {categories}
    {isDemo}
    variant="archive"
    emptyMessage="בקרוב יהיו כאן המתכונים של תמר."
  >
    <RecipeSearch {index} slot="search" client:idle />
  </RecipesPage>
</Layout>
